# Copia este archivo a .env (el servicio lo lee solo si existe; no se sube a git)

# Clave que el cliente (Laravel) envia en la cabecera X-API-Key. OBLIGATORIA.
# Genera una:  python -c "import secrets; print(secrets.token_urlsafe(32))"
INFERENCE_API_KEY=cambia-esta-clave

# Solo para pruebas locales: permite arrancar sin clave (no usar en la nube)
# ALLOW_NO_AUTH=1

# Tamano maximo de imagen en MB (por defecto 10)
MAX_IMAGE_MB=10

# Pesos opcionales (si no existen, ese modelo queda "no_disponible" y devuelve null)
MODELO_M2=modelos/m2_seg.pt
MODELO_M3=modelos/m3_pose.pt
MODELO_M4=modelos/m4_personas.pt

# Mapeo de nombres de clase de M2 a categorias (JSON, opcional)
# MAPEO_M2={"car":"automovil","truck":"camion","bus":"bus","motorcycle":"motocicleta","van":"minibus"}

# auto (CUDA si esta disponible) | cpu
INFERENCE_DEVICE=auto
# Umbral del detector de placas
UMBRAL_PLACA=0.4
