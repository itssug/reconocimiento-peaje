# Copie este archivo a ".env" (fuera del directorio publico) y complete los valores.
# NUNCA suba el archivo .env real a repositorios ni lo coloque dentro de public/.

APP_NAME="Sistema Inteligente de Control de Peaje"
APP_ENV=production            # production | local
APP_DEBUG=false
APP_URL=https://su-dominio.com
APP_TIMEZONE=America/La_Paz

# Clave aleatoria larga (el instalador puede generarla)
APP_KEY=

# Token requerido para ejecutar install.php desde el navegador (elija uno largo)
INSTALL_TOKEN=

# SQLite (ruta relativa a la raiz del proyecto o absoluta)
DB_PATH=storage/database/peaje.sqlite
DB_BUSY_TIMEOUT_MS=5000

# Google OAuth 2.0 (Client ID de tipo "Web application")
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Solo si cURL local no encuentra certificados CA (p. ej. XAMPP en Windows): ruta a cacert.pem
CA_BUNDLE_PATH=

# Sesion de la aplicacion
SESSION_TTL_HOURS=8
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

# Inferencia externa (M1 placas/OCR, M2 vehiculo, M3 ejes). Vacio = modo DEMO
INFERENCE_URL=
INFERENCE_API_KEY=
INFERENCE_TIMEOUT_SECONDS=15
OCR_MIN_CONFIDENCE=0.80

# Validacion de placas bolivianas (expresiones regulares configurables)
PLATE_REGEX="^(\d{3,4})([A-Z]{3})$"

# Evidencias
MAX_IMAGE_MB=5

# Proveedor de IA del agente conversacional (opcional; vacio = modo demostracion)
AGENT_PROVIDER_URL=
AGENT_PROVIDER_KEY=
AGENT_PROVIDER_MODEL=

# Diagnostico: permitir public/diagnostico.php (poner false tras validar el hosting)
DIAG_ENABLED=true
